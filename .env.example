# Exemplo de configuração para a ligação local ao PostgreSQL do FootballIQ.
# Copiar este ficheiro para .env e ajustar apenas os valores locais.
# Este ficheiro não é carregado automaticamente pelo projeto.

FOOTBALLIQ_DB_HOST=127.0.0.1
FOOTBALLIQ_DB_PORT=5432
FOOTBALLIQ_DB_NAME=footballiq_dev
FOOTBALLIQ_DB_USER=footballiq
FOOTBALLIQ_DB_PASSWORD=
FOOTBALLIQ_DB_SSLMODE=prefer
FOOTBALLIQ_DB_RUN_INTEGRATION=0

# O papel do PostgreSQL deve ser definido explicitamente em cada ambiente local.
# Não usar nomes de role fixos no código da aplicação.
